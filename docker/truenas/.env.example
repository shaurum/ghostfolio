COMPOSE_PROJECT_NAME=ghostfolio-truenas

# HOST CONFIGURATION
# ROOT_URL must be reachable from the client browser; adjust to your domain/IP
ROOT_URL=https://YOUR_DOMAIN_OR_IP

# CACHE (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# POSTGRES
POSTGRES_DB=ghostfolio-db
POSTGRES_USER=user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# GHOSTFOLIO
# Generate with: openssl rand -hex 96  (ACCESS_TOKEN_SALT)
#            and: openssl rand -hex 64  (JWT_SECRET_KEY)
ACCESS_TOKEN_SALT=CHANGE_ME_ACCESS_TOKEN_SALT
DATABASE_URL=postgresql://user:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/ghostfolio-db?connect_timeout=300
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY

# DATA SOURCES
# Moscow Exchange (MOEX) is enabled by default. Keep it.
DATA_SOURCES=["COINGECKO","MANUAL","MOSCOW_EXCHANGE","YAHOO"]

# FEATURES
# Enable Google sign-in by providing GOOGLE_CLIENT_ID and GOOGLE_SECRET
# ENABLE_FEATURE_AUTH_GOOGLE=true
# GOOGLE_CLIENT_ID=
# GOOGLE_SECRET=